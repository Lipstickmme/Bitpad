# Copy to .env.deploy (never committed) and fill in. Used by:
#   npm run deploy:factory · npm run deploy:bundler · npm run pair:add

# ── Deployer ──────────────────────────────────────────────────────────
# 24 words of the wallet that deploys and OWNS the factory. Keep it secret.
DEPLOYER_MNEMONIC=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12 word13 word14 word15 word16 word17 word18 word19 word20 word21 word22 word23 word24
# Fee wallet key, only for `npm run referrals:pay` (leave empty if the deployer is the fee wallet)
FEE_WALLET_MNEMONIC=
# W5 (Tonkeeper/MyTonWallet default) = leave empty; older v4 wallets = v4
WALLET_VERSION=
# testnet first, then mainnet
NETWORK=testnet
# free key from @tonapibot on Telegram (avoids rate limits)
TONCENTER_API_KEY=

# ── Factory settings (deploy:factory) ─────────────────────────────────
FEE_WALLET=
LAUNCH_FEE_TON=1
# 50 = 0.5%. Protocol + creator must be ≤ 1000 (10%)
PROTOCOL_FEE_BPS=50
CREATOR_FEE_BPS=50
MIN_TON_LIQUIDITY=5

# ── Bundler (deploy:bundler) ──────────────────────────────────────────
BUNDLE_FEE_BPS=0

# ── Register a pair asset (pair:add) — edit and re-run per asset ──────
FACTORY=
MASTER=EQCxE6mUtQJKFnGfaROTKOt1lZbDiiX1kCixRv7Nw2Id_sDs
SYMBOL=USDT
DECIMALS=6
# stable | jetton | stock | commodity | crypto
KIND=stable
# in whole units
MIN_LIQUIDITY=100
# optional Pyth price-feed id (https://www.pyth.network/developers/price-feed-ids)
PYTH_FEED=0
