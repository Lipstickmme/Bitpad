# ── Required ────────────────────────────────────────────────────────────
# BitpadFactory address from `npm run deploy:factory`. A testnet address
# (kQ…/0Q…) switches the whole app to testnet automatically.
NEXT_PUBLIC_BITPAD_FACTORY=
# Receives the fee on STON.fi / DeDust trades (Bitpad pools use the factory's fee settings)
NEXT_PUBLIC_FEE_WALLET=

# ── Optional (server-only, never sent to the browser) ──────────────────
# Higher TON RPC limits — free key from @tonapibot on Telegram
TONCENTER_API_KEY=
# Higher TonAPI limits — free key from tonconsole.com
TONAPI_KEY=
# Enables Telegram login, the Mini App and the bot. After deploying, open
# https://<your-site>/api/telegram/setup once to connect the bot.
TELEGRAM_BOT_TOKEN=

# Only needed for a custom domain; Vercel's production URL is used otherwise
# NEXT_PUBLIC_APP_URL=https://bitpad.xyz
