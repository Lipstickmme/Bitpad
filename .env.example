# Public URL of the deployment (used for TON Connect manifest + Telegram)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Platform fees ----
# Fee wallet (TON address) that receives STON.fi referral fees + launch fees
NEXT_PUBLIC_FEE_WALLET=
# Swap fee in basis points taken via STON.fi referral (0-100 = 0%-1%)
NEXT_PUBLIC_SWAP_FEE_BPS=50
# Flat launch fee in TON
NEXT_PUBLIC_LAUNCH_FEE_TON=1

# ---- Telegram ----
# Bot token from @BotFather, used server-side to verify Login Widget / Mini App initData
TELEGRAM_BOT_TOKEN=
# Bot username (without @) for the Telegram Login Widget
NEXT_PUBLIC_TELEGRAM_BOT=
# Secret used to sign Bitpad session cookies
SESSION_SECRET=change-me

# ---- TON ----
NEXT_PUBLIC_TON_NETWORK=mainnet
TONCENTER_API_KEY=
NEXT_PUBLIC_TONCENTER_API_KEY=
# Jetton masters for pay assets (USDT is built in)
NEXT_PUBLIC_GRAM_JETTON=
NEXT_PUBLIC_USDC_JETTON=
# $BITL jetton master (adds the $BITL tab)
NEXT_PUBLIC_BITL_JETTON=
# Optional TonAPI key for portfolio lookups
TONAPI_KEY=
# Optional secret for the Telegram bot webhook
TELEGRAM_WEBHOOK_SECRET=
# Deployed BitpadFactory address (see contracts/README.md). Empty = launching is disabled.
NEXT_PUBLIC_BITPAD_FACTORY=
